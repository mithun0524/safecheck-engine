# SafeCheck Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/safecheck"

# LLM Providers (for evidence generation)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Cache
REDIS_URL="redis://localhost:6379"

# App Secrets
SESSION_SECRET="generate-a-secure-secret-here"
